# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND SISTEMA FRUVER (PUERTO 5174)
# ==============================================================================
# URL base de la API Backend (usar /api para proxy automático a http://127.0.0.1:8001)
VITE_API_BASE_URL=/api

# Título y metadatos de la aplicación
VITE_APP_TITLE=Sistema Fruver

# Margen de utilidad predeterminado por producto (%)
VITE_DEFAULT_PROFIT_MARGIN=30

# Retardo para el autoguardado en milisegundos (debounce)
VITE_AUTO_SAVE_DELAY_MS=600

# Límite máximo para subida de archivos (MB)
VITE_MAX_FILE_SIZE_MB=15